  (and completed-enrollment-mode
       completed-enroll-handler
       completed-verify-handler
       completed-unique-set-check)
  completed-phase3)

; Phase 4 readiness (depends on Phase 3)
(normally r-ready-integration-tests-fuzzy
  (and task-integration-tests-fuzzy completed-phase3)
