(normally r-ready-benchmarks-fuzzy
  (and task-benchmarks-fuzzy completed-phase3)
  ready-benchmarks-fuzzy)

(normally r-ready-security-review-fuzzy
  (and task-security-review-fuzzy completed-phase3)
  ready-security-review-fuzzy)

; Phase 4 completion
(normally r-phase4-complete
  (and completed-integration-tests-fuzzy
       completed-parameter-tuning
       completed-benchmarks-fuzzy
       completed-security-review-fuzzy)
  completed-phase4)

; Project completion
(normally r-project-complete
  completed-phase4
  project-complete)

