; =============================================================================
; PHASE 2: CORE CIRCUIT
; Goal: Implement face verification circuit components
; =============================================================================

(given task-impl-quantizer)
(meta task-impl-quantizer
  (title "Implement Feature Quantizer")
  (description "Implement FeatureQuantizer (CON-003): Convert f64 embeddings to u8 bytes with linear quantization")
  (phase "phase-2-core")
  (implements "REQ-005, CON-003")
  (estimate "1h")
  (spec-ref "SPEC-001 Section 6"))

(given task-impl-poseidon-halo2)
(meta task-impl-poseidon-halo2
  (title "Implement Poseidon Hash in Halo2")
  (description "Implement Poseidon hash circuit in Halo2 for commitment verification")
  (phase "phase-2-core")
  (implements "REQ-004")
  (estimate "3h")
  (spec-ref "SPEC-001 ADR-001"))

(given task-impl-hamming-distance)
(meta task-impl-hamming-distance
  (title "Implement Hamming Distance Circuit")
  (description "Implement Hamming distance calculation using XOR operations in Halo2 circuit")
  (phase "phase-2-core")
  (implements "REQ-003")
  (estimate "2h")
  (spec-ref "SPEC-001 ADR-002"))

(given task-impl-threshold-check)
(meta task-impl-threshold-check
  (title "Implement Threshold Comparison")
  (description "Implement threshold comparison constraint to verify similarity >= 50%")
  (phase "phase-2-core")
  (implements "REQ-003")
  (estimate "1h")
  (blocked-by "task-calibrate-hamming-threshold")
  (spec-ref "SPEC-001 Section 5.2"))

(given task-calibrate-hamming-threshold)
