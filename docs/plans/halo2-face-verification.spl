; =============================================================================
; READINESS RULES
; =============================================================================

; Phase 1 readiness
(normally r-ready-add-deps
  (and task-add-halo2-deps no-deps-add-halo2-deps)
  ready-add-halo2-deps)

(normally r-ready-hello-world
  (and task-hello-world-circuit completed-add-halo2-deps)
  ready-hello-world-circuit)

(normally r-ready-benchmark
  (and task-benchmark-halo2 completed-hello-world-circuit)
  ready-benchmark-halo2)

(normally r-ready-findings
  (and task-document-findings completed-benchmark-halo2)
  ready-document-findings)

; Phase 1 completion
(normally r-phase1-complete
  (and completed-add-halo2-deps
       completed-hello-world-circuit
       completed-benchmark-halo2
       completed-document-findings)
  completed-phase1)

; Phase 2 readiness (depends on Phase 1)
(normally r-ready-quantizer
  (and task-impl-quantizer completed-phase1)
  ready-impl-quantizer)

(normally r-ready-poseidon
  (and task-impl-poseidon-halo2 completed-impl-quantizer)
  ready-impl-poseidon-halo2)

(normally r-ready-hamming
  (and task-impl-hamming-distance completed-impl-poseidon-halo2)
  ready-impl-hamming-distance)

; Calibration can run after hamming is done
(normally r-ready-calibration
  (and task-calibrate-hamming-threshold completed-impl-hamming-distance)
  ready-calibrate-hamming-threshold)

; Threshold check requires calibration
(normally r-ready-threshold
  (and task-impl-threshold-check
       completed-impl-hamming-distance
       completed-calibrate-hamming-threshold)
  ready-impl-threshold-check)

; Defeater: threshold blocked until calibration done
(except d-threshold-blocked
  (and task-impl-threshold-check (not completed-calibrate-hamming-threshold))
  ready-impl-threshold-check)

(normally r-ready-unit-tests
  (and task-unit-tests-circuit
       completed-impl-quantizer
       completed-impl-poseidon-halo2
       completed-impl-hamming-distance
       completed-impl-threshold-check)
  ready-unit-tests-circuit)

; Phase 2 completion
(normally r-phase2-complete
  (and completed-impl-quantizer
       completed-impl-poseidon-halo2
       completed-impl-hamming-distance
       completed-impl-threshold-check
       completed-calibrate-hamming-threshold
       completed-unit-tests-circuit)
  completed-phase2)

; Phase 3 readiness (depends on Phase 2)
(normally r-ready-proof-generator
  (and task-impl-proof-generator completed-phase2)
  ready-impl-proof-generator)

(normally r-ready-proof-verifier
  (and task-impl-proof-verifier completed-impl-proof-generator)
  ready-impl-proof-verifier)

(normally r-ready-handlers
  (and task-update-handlers completed-impl-proof-verifier)
  ready-update-handlers)

(normally r-ready-integration
  (and task-integration-tests completed-update-handlers)
  ready-integration-tests)

; Phase 3 completion
(normally r-phase3-complete
  (and completed-impl-proof-generator
       completed-impl-proof-verifier
       completed-update-handlers
       completed-integration-tests)
  completed-phase3)

; Phase 4 readiness (depends on Phase 3)
(normally r-ready-test-specs
  (and task-run-test-specs completed-phase3)
  ready-run-test-specs)

(normally r-ready-perf-bench
  (and task-performance-benchmarks completed-run-test-specs)
  ready-performance-benchmarks)

(normally r-ready-security
  (and task-security-review completed-phase3)
  ready-security-review)

(normally r-ready-docs
  (and task-documentation
       completed-run-test-specs
       completed-performance-benchmarks
       completed-security-review)
  ready-documentation)

; Phase 4 completion
(normally r-phase4-complete
  (and completed-run-test-specs
       completed-performance-benchmarks
       completed-security-review
       completed-documentation)
  completed-phase4)

; Project completion
(normally r-project-complete
  completed-phase4
  project-complete)

