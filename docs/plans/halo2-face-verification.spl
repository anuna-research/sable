  (title "Calibrate Hamming Threshold")
  (description "Empirically determine Hamming distance threshold that corresponds to 0.5 cosine similarity")
  (phase "phase-2-core")
  (estimate "2h")
  (open-question true)
  (spec-ref "SPEC-001 Section 10"))

