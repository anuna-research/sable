(normally r-propagate-build-script-from-rust-cross-compile-stale-v1 stale-v1-rust-cross-compile upstream-blocked-build-script)
(normally r-propagate-build-script-from-rust-cross-compile-timeout-v1 timeout-v1-rust-cross-compile upstream-blocked-build-script)
(normally r-propagate-build-script-from-rust-cross-compile-blocked upstream-blocked-rust-cross-compile upstream-blocked-build-script)
(normally r-propagate-ios-module-from-rust-cross-compile-failed failed-rust-cross-compile upstream-blocked-ios-module)
