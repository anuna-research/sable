(normally r-propagate-android-module-from-rust-cross-compile-failed failed-rust-cross-compile upstream-blocked-android-module)
(normally r-propagate-android-module-from-rust-cross-compile-permanently-failed permanently-failed-rust-cross-compile upstream-blocked-android-module)
(normally r-propagate-android-module-from-rust-cross-compile-stale-v1 stale-v1-rust-cross-compile upstream-blocked-android-module)
(normally r-propagate-android-module-from-rust-cross-compile-timeout-v1 timeout-v1-rust-cross-compile upstream-blocked-android-module)
(normally r-propagate-android-module-from-rust-cross-compile-blocked upstream-blocked-rust-cross-compile upstream-blocked-android-module)
