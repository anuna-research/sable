;; Plan metadata
(meta plan
  (id "SPEC-005")
  (title "SABLE Expo Mobile SDK")
  (version "1.0.0")
  (status "active")
  (created "2026-03-13")
  (author "agent:architect")
  (spec "SPEC-005")
  (description "Implement expo-sable: an Expo Module exposing SABLE ZK proof primitives (commitment, proof gen/verify, fuzzy commitment) to React Native apps via native FFI"))

;; Agents
(given agent-rust-engineer-available)
(given agent-ios-engineer-available)
(given agent-android-engineer-available)
(given agent-ts-engineer-available)
(given agent-qa-engineer-available)

;; ─── Tasks ───────────────────────────────────────────────────────────────────

;; Phase 1: Rust FFI layer

(given task-rust-ffi-exports)
(given no-deps-rust-ffi-exports)

(given task-rust-cross-compile)
(given no-deps-rust-cross-compile)

;; Phase 2: iOS native module

(given task-ios-module)

;; Phase 3: Android native module

(given task-android-module)

;; Phase 4: TypeScript API layer

(given task-ts-api)

;; Phase 5: Integration & Build

(given task-build-script)
(given task-expo-module-config)

;; Phase 6: Correctness Tests

(given task-test-init)
(given task-test-salt)
(given task-test-commitment)
(given task-test-proof-gen)
(given task-test-proof-verify)
(given task-test-fuzzy-enroll)
(given task-test-fuzzy-verify)
(given task-test-error-sanitization)
(given task-test-memory-safety)
(given task-test-zeroization)

;; Phase 7: Performance & Platform Tests

(given task-test-perf-proof-gen)
(given task-test-perf-verify)
(given task-test-proof-size)
(given task-test-binary-size)
(given task-test-memory-consumption)
(given task-test-platform-compat)
(given task-test-thread-safety)
(given task-test-offline)

;; Phase 8: Demo app

(given task-demo-mobile-app)

;; ─── Task Metadata ────────────────────────────────────────────────────────────

(meta task-rust-ffi-exports
  (description "Add or verify C-ABI FFI exports in sable-core for all module functions: generateSalt, generateCommitment, generateProof, verifyProof, fuzzyEnroll, fuzzyVerify, and error-code mapping. Ensure zeroization on sensitive types.")
  (acceptance "All seven FFI functions exported with correct signatures; SableErrorCode enum exposed; ZeroizeOnDrop confirmed on Salt and feature vector types; compiles for iOS (aarch64-apple-ios) and Android (aarch64-linux-android) targets")
  (context-files "core/src/ffi.rs" "core/src/zk/halo2/proof.rs" "core/src/crypto/fuzzy_commitment.rs")
  (evaluate-checks "test:rustup run nightly cargo test --features halo2,mobile -p sable-core"))

(meta task-rust-cross-compile
  (description "Configure cross-compilation of sable-core to all required targets: aarch64-apple-ios, x86_64-apple-ios, aarch64-apple-ios-sim, aarch64-linux-android, armv7-linux-androideabi, x86_64-linux-android. Produce staticlib (iOS) and cdylib (Android). Apply LTO and symbol stripping.")
  (acceptance "cargo build --release succeeds for all six targets; stripped .a ≤ 15MB per iOS arch; stripped .so ≤ 15MB per Android arch")
  (context-files "Cargo.toml" "rust-toolchain.toml" "platform/expo/scripts/build-rust.sh"))

(meta task-ios-module
  (description "Implement SableModule.swift using Expo Modules API. Expose initialize, isReady, generateSalt, generateCommitment, generateProof, verifyProof, fuzzyEnroll, fuzzyVerify as AsyncFunction methods. Dispatch proof generation and verification to background DispatchQueue. Map Rust FFI error codes to SableError. Validate all inputs before FFI calls. Zeroize sensitive data after use.")
  (acceptance "All seven functions callable from JS on iOS simulator and device; background thread dispatch confirmed; null/invalid inputs return InvalidInput SableError; no raw pointers exposed to JS; Memory Instruments shows no leaks over 100 proof cycles")
  (context-files "platform/expo/ios/SableModule.swift" "platform/expo/ios/SableModule.podspec"))

(meta task-android-module
  (description "Implement SableModule.kt using Expo Modules API. Expose the same seven functions via AsyncFunction. Dispatch proof generation and verification to Kotlin coroutine on Dispatchers.Default. Load libsable_core.so via JNI. Map Rust error codes to SableError. Validate inputs before JNI calls. Zeroize sensitive data after use.")
  (acceptance "All seven functions callable from JS on Android emulator (API 24+) and device (API 34, arm64); JNI linkage confirmed; background dispatch confirmed; null/invalid inputs return InvalidInput SableError")
  (context-files "platform/expo/android/src/main/java/expo/modules/sable/SableModule.kt" "platform/expo/android/build.gradle"))

(meta task-ts-api
  (description "Implement the public TypeScript API for expo-sable: Sable.types.ts (ProofOptions, ProofResult, VerifyResult, FuzzyEnrollOptions, FuzzyEnrollResult, SableErrorCode, SableError), SableModule.ts (NativeModule binding), and index.ts (public exports). All functions return Promise. Type all inputs and outputs as specified in CON-001 through CON-008.")
  (acceptance "TypeScript compiles with strict mode; all exported types match contract specifications; SableError extends Error with code property; index.ts re-exports everything; tsd or similar type tests pass")
  (context-files "platform/expo/src/index.ts" "platform/expo/src/Sable.types.ts" "platform/expo/src/SableModule.ts"))

(meta task-build-script
  (description "Write platform/expo/scripts/build-rust.sh that cross-compiles sable-core for all six targets, produces the XCFramework (iOS) and per-ABI .so files (Android), and copies artifacts to the correct locations for CocoaPods and Gradle pickup.")
  (acceptance "Script runs end-to-end on CI (macOS host); produces libsable_core.xcframework and libsable_core_{arm64,armv7,x86_64}.so; artifacts are ≤ size budget per NFR-004")
  (context-files "platform/expo/scripts/build-rust.sh"))

(meta task-expo-module-config
  (description "Create expo-module.config.json, package.json, podspec, and build.gradle for the expo-sable package. Configure Expo Modules API linking. Set deployment targets: iOS 13.0, Android minSdk 24. Declare the package for npx expo install auto-linking.")
  (acceptance "expo prebuild succeeds on a fresh Expo app; expo-sable appears in ios/Podfile and android/settings.gradle automatically; package.json has correct peerDependencies on expo-modules-core and react-native")
  (context-files "platform/expo/expo-module.config.json" "platform/expo/package.json" "platform/expo/ios/SableModule.podspec" "platform/expo/android/build.gradle"))

(meta task-test-init
  (description "TEST-001: Verify initialize() resolves on first call; verify idempotency (second call resolves immediately); verify isReady() returns false before init and true after.")
  (acceptance "All three assertions pass on iOS and Android")
  (evaluate-checks "test:jest --testPathPattern=init"))

(meta task-test-salt
  (description "TEST-002: Verify generateSalt() returns exactly 32 bytes; two sequential calls produce different salts; bytes are not all zeros.")
  (acceptance "All three assertions pass")
  (evaluate-checks "test:jest --testPathPattern=salt"))

(meta task-test-commitment
  (description "TEST-003: Verify generateCommitment() returns 48 bytes; determinism (same inputs → same output); different features → different commitment; different salt → different commitment; InvalidInput for empty, >512 features, salt.length≠32, NaN/Infinity in features.")
  (acceptance "All assertions pass")
  (evaluate-checks "test:jest --testPathPattern=commitment"))

(meta task-test-proof-gen
  (description "TEST-004: Verify generateProof() returns proofBytes ≤ 10KB; durationMs > 0; does not block JS thread (frame drops < 2 during generation); InvalidInput for mismatched commitment length and invalid threshold.")
  (acceptance "All assertions pass; JS thread frame time < 16ms during proof generation")
  (evaluate-checks "test:jest --testPathPattern=proof-gen"))

(meta task-test-proof-verify
  (description "TEST-005: Verify verifyProof() returns true for matching proof; false for distant features; false (not error) for tampered proofBytes; false or ProcessingFailed for random bytes; false for threshold mismatch.")
  (acceptance "All five cases pass")
  (evaluate-checks "test:jest --testPathPattern=proof-verify"))

(meta task-test-fuzzy-enroll
  (description "TEST-006: Verify fuzzyEnroll() returns 32-byte commitment and non-empty helperData; same features with default tolerance are consistent; InvalidInput for features.length≠512; InvalidInput for errorTolerance=0 or 128.")
  (acceptance "All assertions pass")
  (evaluate-checks "test:jest --testPathPattern=fuzzy-enroll"))

(meta task-test-fuzzy-verify
  (description "TEST-007: Verify fuzzyVerify() returns true for identical features; true for features differing in ≤ 2*t positions; false for > 2*t differences; ProcessingFailed for corrupted helperData.")
  (acceptance "All four cases pass")
  (evaluate-checks "test:jest --testPathPattern=fuzzy-verify"))

(meta task-test-error-sanitization
  (description "TEST-008: Verify no error message contains file paths, function names, or stack traces; all errors are SableError with valid SableErrorCode; messages are human-readable but generic.")
  (acceptance "Regex scan of all error messages passes; SableError instanceof check passes for all error paths")
  (evaluate-checks "test:jest --testPathPattern=error-sanitization"))

(meta task-test-memory-safety
  (description "TEST-009: Verify no memory leaks over 1000 sequential commitment+proof cycles (RSS delta < 5MB); null/undefined inputs produce InvalidInput not crash; oversized arrays do not cause buffer overflow.")
  (acceptance "All three assertions pass on iOS and Android")
  (evaluate-checks "test:jest --testPathPattern=memory-safety"))

(meta task-test-zeroization
  (description "TEST-010: Verify via native instrumentation (Instruments / Android Memory Profiler) that salt memory is zeroed after FFI call completes; feature vector memory is not retained in native heap after call.")
  (acceptance "Memory inspection confirms zero bytes at salt allocation site post-call; no retained feature vector allocation detected")
  (evaluate-checks "test:jest --testPathPattern=zeroization"))

(meta task-test-perf-proof-gen
  (description "TEST-012: Benchmark proof generation p95 ≤ 3000ms over 100 invocations on minimum-floor device (iPhone 8 / Snapdragon 625 or simulator profile); p95 ≤ 1000ms on modern device (iPhone 12+ / Snapdragon 865+).")
  (acceptance "Both p95 targets met; results logged with device_model and os_version labels")
  (evaluate-checks "test:jest --testPathPattern=perf-proof-gen"))

(meta task-test-perf-verify
  (description "TEST-013: Benchmark verification p95 ≤ 100ms on minimum-floor device; p95 ≤ 50ms on modern device.")
  (acceptance "Both p95 targets met")
  (evaluate-checks "test:jest --testPathPattern=perf-verify"))

(meta task-test-proof-size
  (description "TEST-014: Assert proofBytes.length ≤ 10240 for all generated proofs.")
  (acceptance "Assertion holds across 100 proof generation calls")
  (evaluate-checks "test:jest --testPathPattern=proof-size"))

(meta task-test-binary-size
  (description "TEST-015: Measure stripped .a (iOS) and .so (Android) per architecture; assert each ≤ 15MB. Measure npm package tarball; assert ≤ 60MB.")
  (acceptance "All size assertions pass after build-rust.sh produces release artifacts")
  (evaluate-checks "test:bash platform/expo/scripts/check-binary-size.sh"))

(meta task-test-memory-consumption
  (description "TEST-016: Profile peak RSS during proof generation on minimum-floor device; assert peak RSS increase ≤ 128MB.")
  (acceptance "RSS increase ≤ 128MB confirmed on iPhone 8 equivalent and low-end Android device")
  (evaluate-checks "test:jest --testPathPattern=memory-consumption"))

(meta task-test-platform-compat
  (description "TEST-017: Build and run test suite on iOS 13 simulator (arm64), iOS 17 device (arm64), Android API 24 emulator (x86_64), Android API 34 device (arm64-v8a).")
  (acceptance "All tests pass on all four targets; no platform-specific failures")
  (evaluate-checks "test:jest --testPathPattern=platform-compat"))

(meta task-test-thread-safety
  (description "TEST-018: Call generateProof() and verifyProof() concurrently from JS; verify no crashes, deadlocks, or data corruption; verify JS thread remains responsive (< 16ms frame time).")
  (acceptance "50 concurrent proof+verify pairs complete without error; JS frame time < 16ms throughout")
  (evaluate-checks "test:jest --testPathPattern=thread-safety"))

(meta task-test-offline
  (description "TEST-019: Run full enrollment + authentication flow with network disabled (airplane mode / no network permission); verify all operations succeed; verify no DNS lookups or network socket creation.")
  (acceptance "Full flow completes offline; network monitor shows zero outbound connections")
  (evaluate-checks "test:jest --testPathPattern=offline"))

(meta task-demo-mobile-app
  (description "Create the demo/mobile/ Expo app that demonstrates the full enrollment and authentication flow using expo-sable. Provides a reference implementation for third-party developers.")
  (acceptance "App runs on iOS and Android via expo prebuild; enrollment flow and authentication flow work end-to-end; README documents setup steps"))

