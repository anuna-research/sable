;; ─── Safety Defeaters ─────────────────────────────────────────────────────────

;; Memory safety test failure blocks demo and platform compat
(except d-block-demo-memory-failure
  failed-test-memory-safety
  (not ready-demo-mobile-app))

;; Binary size over budget blocks platform compat and demo
(except d-block-platform-binary-size
  binary-size-over-budget
  (not ready-test-platform-compat))

;; Error sanitization failure blocks platform compat (security requirement)
(except d-block-platform-error-sanitization
  failed-test-error-sanitization
  (not ready-test-platform-compat))

;; Zeroization failure blocks demo (privacy requirement)
(except d-block-demo-zeroization-failure
  failed-test-zeroization
  (not ready-demo-mobile-app))

;; ─── Superiority ─────────────────────────────────────────────────────────────

(prefer d-block-demo-memory-failure r-ready-demo-mobile-app)
(prefer d-block-platform-binary-size r-ready-test-platform-compat)
(prefer d-block-platform-error-sanitization r-ready-test-platform-compat)
(prefer d-block-demo-zeroization-failure r-ready-demo-mobile-app)

;; ─── Rule Metadata ────────────────────────────────────────────────────────────

(meta d-block-demo-memory-failure
  (description "Memory safety test failure blocks the demo app from being released")
  (justification "Memory leaks on constrained devices would cause OOM kills and degrade user experience"))

(meta d-block-platform-binary-size
  (description "Binary size exceeding NFR-004 budget blocks platform compatibility testing")
  (justification "Oversized binaries cannot be published to npm or distributed via App Store without size relief"))

(meta d-block-platform-error-sanitization
  (description "Error sanitization failures block platform compat — exposing internals is a security violation")
  (justification "REQ-008 is a hard security requirement; no build with leaking errors may proceed to platform testing"))

(meta d-block-demo-zeroization-failure
  (description "Zeroization failure blocks demo app — sensitive data retention is a privacy violation")
  (justification "SABLE's privacy guarantee depends on zeroization of biometric data; a failing demo would misrepresent the system"))
(claims supervisor:ed25519:zhT3QZyz
  :at "2026-03-13T08:08:24Z"
  (given delegated-v1-rust-cross-compile-to-agent:claude)
  (given (during (leased-v1-rust-cross-compile) (moment "2026-03-13T08:08:24Z") (moment "2026-03-13T08:38:24Z")))
  (given claim-v1-rust-cross-compile-by-claude)
  (normally r-cl-state-v1-rust-cross-compile-by-claude claim-v1-rust-cross-compile-by-claude state-claimed-v1-rust-cross-compile-by-claude)
  (normally r-cl-chain-v1-rust-cross-compile-by-claude state-claimed-v1-rust-cross-compile-by-claude claimed-rust-cross-compile)
)

