  ready-test-perf-proof-gen)

(normally r-ready-test-perf-verify
  (and task-test-perf-verify
       completed-test-proof-gen
       completed-test-proof-verify)
  ready-test-perf-verify)

(normally r-ready-test-proof-size
  (and task-test-proof-size completed-test-proof-gen)
