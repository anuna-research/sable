(normally r-phase5-complete
  (and completed-req-018 completed-req-019 completed-req-020)
  completed-phase5)

(normally r-phase6-complete
  (and completed-req-021 completed-req-022 completed-req-023
       completed-req-024 completed-req-025)
  completed-phase6)

(normally r-production-ready
  (and completed-phase1 completed-phase2 completed-phase3
       completed-phase4 completed-phase5 completed-phase6)
  production-ready)

;; ============================================================================
;; ASSIGNMENT RULES
;; ============================================================================

;; Security-sensitive tasks require security agent
(normally r-assign-security
  (and ready-req-001 security-sensitive-req-001 agent-security-available)
  assign-to-req-001-security)

(normally r-assign-security-002
  (and ready-req-002 security-sensitive-req-002 agent-security-available)
  assign-to-req-002-security)

(normally r-assign-security-003
  (and ready-req-003 security-sensitive-req-003 agent-security-available)
  assign-to-req-003-security)

(normally r-assign-security-004
  (and ready-req-004 security-sensitive-req-004 agent-security-available)
  assign-to-req-004-security)

(normally r-assign-security-005
  (and ready-req-005 security-sensitive-req-005 agent-security-available)
  assign-to-req-005-security)

(normally r-assign-security-006
  (and ready-req-006 security-sensitive-req-006 agent-security-available)
  assign-to-req-006-security)

;; Crypto-sensitive tasks require crypto agent
(normally r-assign-crypto-011
  (and ready-req-011 crypto-sensitive-req-011 agent-crypto-available)
  assign-to-req-011-crypto)

(normally r-assign-crypto-012
  (and ready-req-012 crypto-sensitive-req-012 agent-crypto-available)
  assign-to-req-012-crypto)

(normally r-assign-crypto-013
  (and ready-req-013 crypto-sensitive-req-013 agent-crypto-available)
  assign-to-req-013-crypto)

;; Biometric tasks can use biometric agent
(normally r-assign-biometric-007
  (and ready-req-007 agent-biometric-available)
  assign-to-req-007-biometric)

(normally r-assign-biometric-008
  (and ready-req-008 agent-biometric-available)
  assign-to-req-008-biometric)

;; QA for testing tasks
(normally r-assign-qa-024
  (and ready-req-024 agent-qa-available)
  assign-to-req-024-qa)

;; ============================================================================
;; DEFEATERS - Exceptional conditions that block progress
;; ============================================================================

;; Security audit findings block production readiness
(except d-audit-findings
  (and completed-req-021 found-critical-vulnerabilities)
  production-ready)

;; Missing research validation blocks quality threshold acceptance
(except d-missing-research
  (and ready-req-010 missing-peer-reviewed-citations)
  completed-req-010)

;; Failed performance benchmarks block NFR completion
(except d-perf-failure
  (and ready-req-022 benchmark-regression-detected)
  completed-req-022)

;; Trusted setup compromise blocks proof system
(except d-setup-compromise
  (and completed-req-012 toxic-waste-not-destroyed)
  completed-phase3)

;; ============================================================================
;; SUPERIORITY RELATIONS
;; ============================================================================

;; Security agent takes priority for security-sensitive tasks
(prefer r-assign-security r-assign-biometric-007)
(prefer r-assign-crypto-011 r-assign-biometric-007)

;; Defeaters take priority over completion rules
(prefer d-audit-findings r-production-ready)
(prefer d-missing-research r-ready-req-010)
(prefer d-perf-failure r-ready-req-022)
(prefer d-setup-compromise r-phase3-complete)

