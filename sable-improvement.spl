;; ============================================================================
;; PHASE COMPLETION RULES
;; ============================================================================

(normally r-phase1-complete
  (and completed-req-001 completed-req-002 completed-req-003
       completed-req-004 completed-req-005 completed-req-006)
  completed-phase1)

(normally r-phase2-complete
  (and completed-req-007 completed-req-008 completed-req-009 completed-req-010)
